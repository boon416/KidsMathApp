<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFF8E1">

    <!-- Back Button (Top-Left Corner) -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="‹"
        android:textSize="24sp"
        android:textColor="#000000"
        android:backgroundTint="#CCCCCC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Content Group (centered vertically) -->
    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp">

        <!-- Feedback Image -->
        <ImageView
            android:id="@+id/imgFeedback"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/compare"
            android:contentDescription="Feedback Image"
            android:layout_marginBottom="16dp" />

        <!-- Prompt -->
        <TextView
            android:id="@+id/txtPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Which is Bigger?"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Numbers -->
        <TextView
            android:id="@+id/txtNumbers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123 vs 456"
            android:textSize="32sp"
            android:layout_marginBottom="24dp" />

        <!-- Buttons Row -->
        <LinearLayout
            android:id="@+id/btnRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Left" />

            <View
                android:layout_width="20dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Right" />
        </LinearLayout>

        <!-- Feedback Result -->
        <TextView
            android:id="@+id/txtResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="24sp"
            android:textColor="#FF5722" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
